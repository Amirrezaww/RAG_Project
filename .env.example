# Copy this file to API.env and fill in your own keys.
# load_dotenv('API.env') reads these at runtime. Never commit the real file.

# --- LLM generation & evaluation (OpenAI-compatible endpoint) ---
OPENROUTER_API_KEY=your_openrouter_key_here

# --- Embeddings / reranking ---
HUGGINGFACE_API_KEY=your_hf_token_here   # used by Weaviate text2vec-huggingface
COHERE_API_KEY=your_cohere_key_here      # used for reranking

# --- Optional: Google Gemini (alternative judge/generator) ---
GEMINI_API_KEY=your_gemini_key_here

# --- Weaviate Cloud (vector database) ---
WEAVIATE_URL=https://your-cluster.weaviate.network
WEAVIATE_API_KEY=your_weaviate_key_here

# --- Arize Phoenix (observability / tracing) ---
PHOENIX_API_KEY=your_phoenix_key_here
WORKSPACE_ID=your_phoenix_workspace_id
